{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "传统视频分镜",
  "type": "object",
  "required": ["schema_version", "job_id", "scenes"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_ratio", "end_ratio", "type", "text"],
        "properties": {
          "start_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "end_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "type": {
            "enum": ["evidence", "diagram", "data", "process", "ai_scene", "licensed_external"]
          },
          "text": {"type": "string"},
          "asset": {"type": ["string", "null"]},
          "source": {"type": ["string", "null"]},
          "values": {"type": "array"},
          "steps": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
